# 脚本共用配置。复制为 config.env 后按实际情况修改。
# 建议放在 ~/proxy-tools/config.env，也可放在本目录（脚本优先读同目录，其次读 ~/proxy-tools）。

# ── 组名 ──────────────────────────────────────────────────────
# AI 专用住宅出口（成员唯一）
AI_GROUP="AI-RESIDENTIAL"

# MATCH 兜底的可切换组
FALLBACK_GROUP="FALLBACK-OUT"

# FALLBACK_GROUP 里的两个成员名（成员名必须与 groups 配置完全一致）
MEMBER_RESIDENTIAL="AI-RESIDENTIAL"
MEMBER_RELAY="RELAY-NODE"

# global 模式使用的组
GLOBAL_GROUP="GLOBAL"
# global 模式要强制选中的节点（防止订阅更新把选中项漂到已失效节点）
GLOBAL_PIN_MEMBER="RESIDENTIAL-NODE"

# ── mihomo 运行时 API ─────────────────────────────────────────
# Clash Verge 把内核 socket 放在 /var/run/clash-verge-service/users/<uid>/
MIHOMO_SOCK="/var/run/clash-verge-service/users/$(id -u)/verge-mihomo.sock"
# Verge 默认 secret，改了这里也要改
MIHOMO_TOKEN="set-your-secret"

# ── Verge 配置目录 ────────────────────────────────────────────
CLASH_DIR="$HOME/Library/Application Support/io.github.clash-verge-rev.clash-verge-rev"
PROFILES_DIR="$CLASH_DIR/profiles"

# ── 出口标签（面板用）──────────────────────────────────────────
# 可选：把已知出口 IP 映射成「住宅 / 机房」，面板会按此着色。
# 路径：~/proxy-tools/exit-tags.json
# 内容示例：{"203.0.113.10": "住宅", "198.51.100.20": "机房"}
EXIT_TAGS_JSON="$HOME/proxy-tools/exit-tags.json"
